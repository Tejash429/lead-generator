generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Lead {
  id            String   @id @default(cuid())
  placeId       String   @unique
  businessName  String
  address       String
  phone         String?
  website       String?
  rating        Float?
  ratingCount   Int?
  category      String
  city          String
  hasWebsite    Boolean  @default(false)
  websiteSpeed  Int?
  websiteStatus String?
  leadScore     Int?
  status        String   @default("new")
  notes         String?
  savedAt       DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([city, category])
  @@index([hasWebsite])
  @@index([status])
  @@map("leads")
}

model SearchHistory {
  id         String   @id @default(cuid())
  city       String
  category   String
  results    Int
  leads      Int
  searchedAt DateTime @default(now())

  @@map("search_history")
}
