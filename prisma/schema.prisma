generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id              String    @id @default(cuid())
  placeId         String    @unique
  businessName    String
  address         String
  phone           String?
  website         String?
  rating          Float?
  ratingCount     Int?
  category        String
  city            String
  hasWebsite      Boolean   @default(false)
  websiteSpeed    Int?
  websiteStatus   String?
  leadScore       Int?
  isFavorite      Boolean   @default(false)
  status          String    @default("new")
  notes           String?
  lastContactedAt DateTime?
  savedAt         DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([city, category])
  @@index([hasWebsite])
  @@index([status])
  @@index([isFavorite])
  @@map("leads")
}

model SearchHistory {
  id         String   @id @default(cuid())
  city       String
  category   String
  results    Int
  leads      Int
  searchedAt DateTime @default(now())

  @@map("search_history")
}
